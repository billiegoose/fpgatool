@@ -2085,6 +2085,9 @@
         //     width-1 default kills the B-side read path on silicon.
         //   - RAMB18E1 READ_WIDTH_A=36: READ_WIDTH_B_18.
         //   - RAMB18E1 WRITE_WIDTH_B=36: WRITE_WIDTH_A_18.
+        //   - RAMB36E1 WRITE_WIDTH_B=72: WRITE_WIDTH_A_18 on BOTH
