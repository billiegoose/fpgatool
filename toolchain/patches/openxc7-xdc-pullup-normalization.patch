                                            pair.first.c_str(), c->name.c_str(ctx), lineno);
                         num_errors++;
                     }
+                    // Keep the XDC property itself, as for every other property above,
+                    // then derive the internal attribute consumed by the FASM writer.
+                    // Retaining PULLUP/PULLDOWN also preserves duplicate-property
+                    // detection if the same constraint appears again later in the file.
                     c->attrs[id_prop] = std::string(pair.second);
+                    if (pair.first == "PULLUP" || pair.first == "PULLDOWN") {
+                        std::string value = pair.second;
+                        boost::algorithm::to_upper(value);
+                        bool valid_value = value == "TRUE" || value == "FALSE" || value == "1" || value == "0";
+                        if (!valid_value) {
+                            log_nonfatal_error(
+                                    "property '%s' for cell '%s' must be TRUE, FALSE, 1, or 0, not '%s' (on line %d)\n",
+                                    pair.first.c_str(), c->name.c_str(ctx), pair.second.c_str(), lineno);
+                            num_errors++;
+                        } else if (value == "TRUE" || value == "1") {
+                            bool conflicting_pull = c->attrs.count(id_PULLTYPE) &&
+                                                    c->attrs.at(id_PULLTYPE).as_string() != "NONE" &&
+                                                    c->attrs.at(id_PULLTYPE).as_string() != pair.first;
+                            if (conflicting_pull) {
+                                log_nonfatal_error(
+                                        "conflicting PULLUP/PULLDOWN properties for cell '%s' (on line %d)\n",
+                                        c->name.c_str(ctx), lineno);
+                                num_errors++;
+                            }
+                            c->attrs[id_PULLTYPE] = std::string(pair.first);
+                        } else if (c->attrs.count(id_PULLTYPE) && c->attrs.at(id_PULLTYPE).as_string() == pair.first) {
+                            c->attrs[id_PULLTYPE] = std::string("NONE");
+                        }
+                    }
                     if (pair.first == "PACKAGE_PIN")
                         c->attrs[id_LOC] = std::string(pair.second);
                 }
