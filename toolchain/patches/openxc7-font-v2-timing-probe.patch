+    # The physical RAMB36 block has L/U clock pins. Its data bus spans both
+    # halves, so constrain it against both pins (they are driven by the same
+    # logical clock). Existing suffixed address/enable clocks remain exact.
+    def bram36_clocks(clock):
+        return (clock,) if clock.endswith(("L", "U")) else (clock + "L", clock + "U")
