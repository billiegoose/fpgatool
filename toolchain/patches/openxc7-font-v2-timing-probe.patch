+def import_unregistered_multiplier_timings(timing, sdf):
+    # Diagnostic model ONLY: valid for the renderer's AREG=BREG=MREG=PREG=0,
+    # DIRECT A/B, USE_DPORT=FALSE, USE_MULT=MULTIPLY configuration.
+    dsp = timing.add_cell_variant("DEFAULT", "DSP48E1_DSP48E1")
+    for port, width, kind in (
+        ("A", 30, "DSP48E1_AREG_0_A_INPUT_DIRECT_MREG_0_PREG_0_USE_DPORT_FALSE_USE_MULT_MULTIPLY"),
+        ("B", 18, "DSP48E1_BREG_0_B_INPUT_DIRECT_MREG_0_PREG_0_USE_MULT_MULTIPLY")):
+        entries = [e for e in sdf.cells[(kind, "DSP48E1")].entries
+                   if isinstance(e, parse_sdf.IOPath) and e.from_pin == port and e.to_pin == "P"]
+        assert len(entries) == 1
+        e = entries[0]
+        delay = TimingValue(int(min(e.rising.minv,e.falling.minv)*1000),
+                            int(max(e.rising.maxv,e.falling.maxv)*1000))
+        for i in range(width):
+            for j in range(48):
+                dsp.add_comb_arc(f"{port}{i}",f"P{j}",delay)
+

