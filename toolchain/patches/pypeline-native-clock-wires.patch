+class AsyncWire(metaclass=_AsyncWireMeta):
+    """An explicit asynchronous global connection between clock domains.
+
+    Like Wire[T], but permits readers in a different MAIN clock domain.
+    This inserts no synchronization: the receiving hardware must provide
+    an appropriate synchronizer or CDC protocol. Use make_clock() on a
+    regular Wire[uint1_t] for clock nets themselves.
+    """
