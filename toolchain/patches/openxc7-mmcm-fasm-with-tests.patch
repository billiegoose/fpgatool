+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include "command.h"
+#include "gtest/gtest.h"
+#include "nextpnr.h"
+#include "uarch/xilinx/xilinx.h"
+#define HIMBAECHEL_CONSTIDS "uarch/xilinx/constids.inc"
+#include "himbaechel_constids.h"
+
+USING_NEXTPNR_NAMESPACE
+
+class XilinxFasmTest : public ::testing::Test
+{
+  protected:
+    void SetUp() override
+    {
+        init_share_dirname();
+        chip_args.device = "xc7a50tcsg324-1";
+        ctx = new Context(chip_args);
+        ctx->uarch->init(ctx);
+        ctx->late_init();
+        xil = reinterpret_cast<XilinxImpl *>(ctx->uarch.get());
+
+        fasm_path = std::filesystem::temp_directory_path() / "nextpnr-xilinx-mmcm-fasm-test.fasm";
+        std::error_code ec;
+        std::filesystem::remove(fasm_path, ec);
+    }
+
+    void TearDown() override
+    {
+        std::error_code ec;
+        std::filesystem::remove(fasm_path, ec);
+        delete ctx;
+    }
+
+    CellInfo *create_placed_mmcm()
+    {
+        CellInfo *ci = ctx->createCell(ctx->id("mmcm"), id_MMCME2_ADV_MMCME2_ADV);
+        BelId target;
+        for (BelId bel : ctx->getBels()) {
+            if (ctx->getBelBucketForBel(bel) == id_MMCME2_ADV) {
+                target = bel;
+                break;
+            }
+        }
+        EXPECT_NE(target, BelId());
+        if (target != BelId())
+            ctx->bindBel(target, ci, STRENGTH_LOCKED);
+        return ci;
+    }
+
+    std::string emit_fasm()
+    {
+        xil->write_fasm(fasm_path.string());
+        std::ifstream f(fasm_path);
+        EXPECT_TRUE(f.good());
+        std::ostringstream ss;
+        ss << f.rdbuf();
+        return ss.str();
+    }
+
+    static void expect_contains(const std::string &text, const std::string &needle)
+    {
+        EXPECT_NE(text.find(needle), std::string::npos) << "missing FASM feature: " << needle;
+    }
+
+    ArchArgs chip_args;
+    Context *ctx = nullptr;
+    XilinxImpl *xil = nullptr;
+    std::filesystem::path fasm_path;
+};
+
+TEST_F(XilinxFasmTest, mmcm_programs_vivado_filter_power_and_unused_counter_defaults)
+{
+    CellInfo *mmcm = create_placed_mmcm();
+    mmcm->params[ctx->id("CLKFBOUT_MULT_F")] = Property("5.000000");
+    mmcm->params[id_BANDWIDTH] = Property("OPTIMIZED");
+
+    const std::string fasm = emit_fasm();
+
+    // Vivado goldens put the loop-filter lookup in TABLE, leave
+    // FILTREG1_RESERVED at 0x8, and program POWER_REG as 0x100.
+    expect_contains(fasm, "MMCME2_ADV.FILTREG1_RESERVED[11:0] = 12'b000000001000");
+    expect_contains(fasm, "MMCME2_ADV.POWER_REG_POWER_REG_POWER_REG[15:0] = 16'b0000000100000000");
+    expect_contains(fasm, "MMCME2_ADV.TABLE[9:0] = 10'b1101011100"); // optimized MULT=5 -> 0x35c
+
+    // Unused MMCM outputs are still programmed as divide-by-1 counters with
+    // NO_COUNT set; leaving these fields all-zero does not match Vivado.
+    expect_contains(fasm, "MMCME2_ADV.CLKOUT1_CLKOUT1_HIGH_TIME[5:0] = 6'b000001");
+    expect_contains(fasm, "MMCME2_ADV.CLKOUT1_CLKOUT1_LOW_TIME[5:0] = 6'b000001");
+    expect_contains(fasm, "MMCME2_ADV.CLKOUT1_CLKOUT2_NO_COUNT[0]");
+    expect_contains(fasm, "MMCME2_ADV.CLKOUT5_CLKOUT2_FRACTIONAL_NO_COUNT[0]");
+    expect_contains(fasm, "MMCME2_ADV.CLKOUT6_CLKOUT2_FRACTIONAL_NO_COUNT[0]");
+}
+
+TEST_F(XilinxFasmTest, mmcm_filter_table_tracks_bandwidth_and_multiplier)
+{
+    CellInfo *mmcm = create_placed_mmcm();
+    mmcm->params[ctx->id("CLKFBOUT_MULT_F")] = Property("8.000000");
+    mmcm->params[id_BANDWIDTH] = Property("LOW");
+
+    const std::string fasm = emit_fasm();
+    expect_contains(fasm, "MMCME2_ADV.FILTREG1_RESERVED[11:0] = 12'b000000001000");
+    expect_contains(fasm, "MMCME2_ADV.POWER_REG_POWER_REG_POWER_REG[15:0] = 16'b0000000100000000");
+    expect_contains(fasm, "MMCME2_ADV.TABLE[9:0] = 10'b0010001100"); // LOW MULT=8 -> 0x08c
+}
+
+TEST_F(XilinxFasmTest, mmcm_multiplier_accepts_full_table_range_and_rejects_out_of_range)
+{
+    CellInfo *mmcm = create_placed_mmcm();
+    mmcm->params[id_BANDWIDTH] = Property("OPTIMIZED");
+
+    mmcm->params[ctx->id("CLKFBOUT_MULT_F")] = Property("64.000000");
+    EXPECT_NO_THROW(emit_fasm());
+
+    for (const char *invalid : {"0.000000", "-1.000000", "65.000000"}) {
+        mmcm->params[ctx->id("CLKFBOUT_MULT_F")] = Property(invalid);
+        EXPECT_THROW(emit_fasm(), log_execution_error_exception);
+    }
+}
